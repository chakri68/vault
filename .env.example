# Family Vault — server configuration.
# Nothing in here can decrypt anything. If a variable would let the server read
# a document, it doesn't belong in the environment. No vault password, no master
# key, no recovery code. Ever.

# ── Storage (server-side only) ───────────────────────────────────────────────
# r2       : a Cloudflare R2 bucket over the S3 API. One request per write, and
#            the compare-and-swap is the bucket's own (If-Match/If-None-Match).
# github   : a dedicated PRIVATE repository, written through the Git Data API
# local-fs : a folder on this server's disk (development, or self-hosting on a
#            machine with a real filesystem; useless on serverless)
STORAGE_PROVIDER=r2

# Leave the bucket private: do NOT attach an r2.dev URL or a custom domain to it.
# Encryption is the control, but a world-readable store is an invitation, and
# nothing here can detect one — bucket visibility is invisible over the S3 API.
# Credentials come from R2 → Manage API Tokens → Create token, scoped
# "Object Read & Write" on this one bucket. Those are S3 keys; a Cloudflare API
# token or a wrangler login will not authenticate here.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# GITHUB_PAT=               # fine-grained token: Contents read/write on that one repository, nothing else
# GITHUB_OWNER=
# GITHUB_REPOSITORY=
# GITHUB_BRANCH=main
# LOCAL_STORE_DIR=.vault-store

# ── Server auth ──────────────────────────────────────────────────────────────
# Signs session cookies. At least 32 characters; required in production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Passkeys are bound to this domain for good. Change it and every fingerprint
# unlock stops working (the family password and recovery code still do).
# Left empty, both are taken from the request's Host header.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Optional. If set, creating or restoring a vault on an empty store asks for it,
# so whoever finds the URL first can't claim your storage.
SETUP_TOKEN=

# ── Limits (enforced by the server; the client's are hints) ─────────────────
MAX_OBJECT_SIZE_MB=50

# Shown in Settings → Technical details so the family can compare it with the
# public source. Vercel sets VERCEL_GIT_COMMIT_SHA on its own.
# COMMIT_SHA=
